LOCALRAG_DATABASE_URL=postgresql://localrag:localrag@localhost:5433/localrag

# Paikalliset embeddingit (oletus). Aja ensin: ollama pull bge-m3
LOCALRAG_EMBEDDING_PROVIDER=ollama
LOCALRAG_EMBEDDING_MODEL=bge-m3
LOCALRAG_EMBEDDING_DIM=1024
LOCALRAG_OLLAMA_URL=http://localhost:11434

# Vaihtoehto: OpenAI
# LOCALRAG_EMBEDDING_PROVIDER=openai
# LOCALRAG_EMBEDDING_MODEL=text-embedding-3-small
# LOCALRAG_EMBEDDING_DIM=1536
# LOCALRAG_OPENAI_API_KEY=sk-...

# Reranker: paikallinen monikielinen cross-encoder (ladataan ensimmäisellä haulla, noin 0,6 Gt).
# Poista käytöstä arvolla none.
LOCALRAG_RERANKER=fastembed
LOCALRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
LOCALRAG_RERANK_CANDIDATES=10

LOCALRAG_CHUNK_TARGET_TOKENS=500
LOCALRAG_CHUNK_OVERLAP_TOKENS=60
